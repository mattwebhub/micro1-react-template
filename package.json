{
  "name": "react-frontend-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src tests vite.config.ts vitest.config.ts playwright.config.ts --max-warnings=0",
    "lint:fix": "eslint src tests vite.config.ts vitest.config.ts playwright.config.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "architecture:check": "depcruise --config dependency-cruiser.cjs src",
    "api:generate": "openapi-typescript contracts/openapi.yaml -o src/shared/api/generated/schema.d.ts",
    "api:check": "pnpm api:generate && git diff --exit-code -- contracts/openapi.yaml src/shared/api/generated/schema.d.ts",
    "dead-code:check": "knip",
    "bundle:check": "node scripts/check-bundle.mjs",
    "hooks:install": "lefthook install",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm architecture:check && pnpm api:check && pnpm test",
    "verify": "pnpm verify:fast && pnpm dead-code:check && pnpm build && pnpm bundle:check && pnpm e2e",
    "check:fast": "pnpm verify:fast",
    "check": "pnpm verify"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.5.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.68.0",
    "react-i18next": "^16.2.0",
    "react-router-dom": "^7.9.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "web-vitals": "^6.2.1",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/eslint-plugin": "^1.6.4",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-testing-library": "^7.13.3",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "msw": "^2.12.4",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.17",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "5.0.0"
  }
}
